{
  "manifest_version": 3,
  "name": "iVAS OTP Bridge (Cloudflare Bypass)",
  "version": "1.0",
  "description": "Background script to sync iVAS SMS to Render Bot.",
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.ivasms.com/*",
    "*://*.onrender.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.ivasms.com/portal*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
